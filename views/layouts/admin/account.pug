doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title}
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="/assets/user/styleAccount.css")
  body
    .container
      // Bên trái: Logo & Giới thiệu
      .sidebar
        .brand
          .brand__logo
            i.fa-solid.fa-bolt
          h1.brand__title
            span.highlight EcoHub 
            | Mobility
          p.brand__subtitle Hệ thống điều phối xe điện Khu đô thị ĐHQG-HCM
      .main-content
        block main
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    