extends ../../layouts/admin/default.pug

block titleName
  h1.dashboard-header__title Phân hệ Mô phỏng Kịch bản (What-If Simulation Suite)

block main 
  .simulation-page.container
    
    // =========================================
    // THANH TAB CHỌN KỊCH BẢN
    // =========================================
    include ../../mixins/admin/simulation-tabs.pug
    //- Gọi mixin với id của tab 5 (VD: 'concentration')
    +simulationTabs('concentration')

    // =========================================
    // KHU VỰC CHÍNH (2 CỘT)
    // =========================================
    .simulation-layout
      
      // ================= CỘT TRÁI: FORM THIẾT LẬP =================
      .simulation-left
        .card.settings-card
          .card-header
            h2.card-title
              i.fa-solid.fa-sliders.text-green
              | THIẾT LẬP KỊCH BẢN

          .card-body
            .form-group
              label.form-label HUB TẬP TRUNG PHƯƠNG TIỆN
              select.form-control
                option HUB_METRO (Ga Metro ĐHQG)
                option HUB_BK_CS2 (ĐH Bách Khoa CS2)
                option HUB_UIT_IU (ĐH CNTT - Quốc Tế)
            
            .form-group
              label.form-label XE HIỆN TẠI TẠI HUB
              .form-control.readonly 14 xe (Trạng thái cân bằng)
            
            .form-group
              label.form-label XE GIẢ ĐỊNH DỒN VỀ TRẠM
              input.form-control(type="text", value="32 xe (+128% tích tụ)")
            
            .form-group
              label.form-label NHU CẦU XUẤT PHÁT DỰ KIẾN
              .form-control.readonly 16 xe/giờ (Thấp so với tổng xe)

          .card-footer
            button.btn-run(type="button")
              i.fa-solid.fa-play
              | Chạy mô phỏng kịch bản

      // ================= CỘT PHẢI: KẾT QUẢ MÔ PHỎNG =================
      .simulation-right
        .simulation-result-wrapper
          
          //- KHỐI 1: SO SÁNH TRẠNG THÁI
          .simulation-section
            h3.section-label SO SÁNH TRẠNG THÁI
            
            .status-compare-grid
              //- Box Trạng thái hiện tại
              .status-box.status-box--current
                .status-box__title TRẠNG THÁI HIỆN TẠI
                .status-box__list
                  .status-row
                    span Phân bổ phương tiện:
                    strong 14 xe tại HUB_METRO
                  .status-row
                    span Tỷ lệ lấp pin xe:
                    strong 0% (Đạt cân bằng)
                  .status-row
                    span Trạng thái mạng lưới:
                    strong.text-green Cân bằng ổn định
                    
              //- Box Trạng thái mô phỏng
              .status-box.status-box--simulated
                .status-box__title TRẠNG THÁI MÔ PHỎNG
                .status-box__list
                  .status-row
                    span Xe tích tụ giả định:
                    strong 32 xe dồn về trạm
                  .status-row
                    span Mức xe tồn đọng dư thừa:
                    strong.text-red +16 xe dư thừa
                  .status-row
                    span Cảnh báo:
                    strong.text-red Mất cân bằng trầm trọng cục bộ

          //- KHỐI 2: KẾT QUẢ ĐÁNH GIÁ
          .simulation-section
            h3.section-label KẾT QUẢ ĐÁNH GIÁ
            
            .evaluation-grid
              //- Thẻ Cam (Dư xe)
              .eval-card.eval-card--orange
                span.eval-card__label Hub dư xe tồn đọng
                .eval-card__value.eval-card--small HUB_METRO (+16 xe)
                span.eval-card__sub Tỷ lệ sử dụng thấp
                
              //- Thẻ Đỏ (Thiếu xe)
              .eval-card.eval-card--red
                span.eval-card__label Hub thiếu xe lân cận
                .eval-card__value.eval-card--small HUB_UIT_IU (-8 xe)
                span.eval-card__sub Cần bổ sung gấp
                
              //- Thẻ Đỏ (Mức độ)
              .eval-card.eval-card--red
                span.eval-card__label Mức độ mất cân bằng
                .eval-card__value.eval-card--small Mức Cao ⚠
                span.eval-card__sub Lãng phí tài nguyên xe

          //- KHỐI 3: KHUYẾN NGHỊ VẬN HÀNH
          .recommendation-card
            .recommendation-header
              .recommendation-header__title-group
                i.fa-regular.fa-lightbulb.text-green
                h3 KHUYẾN NGHỊ VẬN HÀNH
              span.recommendation-header__badge Vehicle Redistribution
              
            .recommendation-body
              .recommendation-content
                h4 Tạo lệnh Điều phối Tái cân bằng Mạng lưới Phương tiện
                p
                  | Tạo lệnh giả lập tối khẩn cấp: Rút 
                  strong 12 xe máy điện
                  |  tồn đọng từ HUB_METRO sang điều phối cho các trạm đang thiếu hụt phương tiện (
                  strong 8 xe sang HUB_UIT_IU
                  |  &amp; 
                  strong 4 xe sang HUB_KTX_B
                  | ) trước 17:00.
                p.recommendation-alternative
                  | Dynamic Incentive Policy: Khuyến khích kích hoạt chính sách ưu đãi giá cuốc (Giảm 15% cước chuyến) cho sinh viên thuê xe xuất phát từ HUB_METRO sang trạm thiếu xe.

            .recommendation-footer
              button.btn-action(type="button")
                | Xem phương án điều phối
                i.fa-solid.fa-arrow-right