extends ../../layouts/admin/account.pug

block main 
  // Bên phải: Form đăng nhập
  .login 
    h2.login__title Đăng nhập

    //- Thêm ID cho form và name cho các input
    form.form#login-form
      // SĐT / EMAIL
      .form__group
        label.form__label SĐT / EMAIL
        .input-wrapper
          input#loginIdentifier.form__input(type="text" name="identifier" placeholder="Nhập SĐT hoặc Email")

      // Mật khẩu
      .form__group
        label.form__label MẬT KHẨU
        .input-wrapper
          input#loginPassword.form__input(type="password" name="password" placeholder="Nhập mật khẩu")
          //- Thêm ID cho icon mắt để bật/tắt hiển thị mật khẩu
          i#togglePassword.fa-regular.fa-eye.input-icon-right(style="cursor: pointer;")

      // Quên mật khẩu
      .form__forgot-password
        a(href="/admin/reset-password") Quên mật khẩu?

      // Nút xác nhận
      button.btn-submit(type="submit") Xác nhận