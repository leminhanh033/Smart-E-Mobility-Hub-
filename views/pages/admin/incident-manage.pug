extends ../../layouts/admin/default.pug

block titleName
  h1.dashboard-header__title Quản lý Sự cố & Bảo trì Thiết bị

block main 
  .incident-wrapper.container
    
    // =========================================
    // HÀNG 1: THỐNG KÊ (STATS)
    // =========================================
    .stats-grid
      .stat-card
        .stat-card__header
          .stat-card__info
            span.stat-card__label PHIẾU SỰ CỐ ĐANG MỞ
            .stat-card__value #{stats.openCount || 0} &nbsp; Phiếu
            span.stat-card__sub.text-red
              i.fa-solid.fa-triangle-exclamation
              | Cần xử lý ngay
          .stat-card__icon.bg-red-light
            i.fa-regular.fa-clock
      
      .stat-card
        .stat-card__header
          .stat-card__info
            span.stat-card__label THIẾT BỊ ĐANG BẢO TRÌ
            .stat-card__value #{stats.maintenanceCount || 0} &nbsp; Thiết bị
            span.stat-card__sub.text-orange
              i.fa-solid.fa-circle
              | Đang cô lập điện
          .stat-card__icon.bg-orange-light
            i.fa-solid.fa-screwdriver-wrench

      .stat-card
        .stat-card__header
          .stat-card__info
            span.stat-card__label THỜI GIAN XỬ LÝ TB (SLA)
            .stat-card__value 14.2 &nbsp; Phút
            span.stat-card__sub.text-green
              i.fa-solid.fa-check
              | Đạt mục tiêu < 20 phút
          .stat-card__icon.bg-green-light
            i.fa-solid.fa-stopwatch

      .stat-card
        .stat-card__header
          .stat-card__info
            span.stat-card__label ĐÃ KHẮC PHỤC HÔM NAY
            .stat-card__value #{stats.resolvedCount || 0} &nbsp; Phiếu
            span.stat-card__sub.text-green
              i.fa-solid.fa-check-double
              | 100% đã xác nhận
          .stat-card__icon.bg-green-light
            i.fa-regular.fa-circle-check

    // =========================================
    // HÀNG 2: LAYOUT CHÍNH
    // =========================================
    .incident-layout
      
      // ---- CỘT TRÁI: DANH SÁCH ----
      .incident-left
        .card
          .card-header
            h2.card-title Danh sách Cảnh báo & Sự cố Hạ tầng
          
          .table-responsive
            table.data-table
              thead
                tr
                  th #
                  th MÃ TICKET
                  th THIẾT BỊ
                  th VỊ TRÍ HUB
                  th LOẠI SỰ CỐ
                  th NGUỒN PHÁT HIỆN
                  th THỜI GIAN
                  th MỨC ĐỘ
              tbody
                if reports && reports.length > 0
                  each report, index in reports
                    //- Gắn data-status để JS đọc trạng thái
                    tr.incident-row(
                      data-id=report._id
                      data-ticket=report.ticketCode
                      data-vehicle=report.vehicle
                      data-hub=report.hubName
                      data-type=report.typeLabel
                      data-createdby=report.creatorName
                      data-time=report.timeFormatted
                      data-status=report.status
                    )
                      td= index + 1
                      td.font-bold= report.ticketCode
                      td
                        strong= report.vehicle
                      td= report.hubName
                      td.text-red= report.typeLabel
                      td
                        strong= report.creatorName
                      td
                        strong= report.timeFormatted
                      td
                        if report.status === 'Urgent'
                          span.badge.badge--red Urgent
                        else if report.status === 'Medium'
                          span.badge.badge--orange Medium
                        else if report.status === 'Resolved'
                          span.badge.badge--green Resolved
                        else if report.status === 'In Progress'
                          span.badge.badge--blue Đang xử lý
                        else
                          span.badge.badge--gray Low
                else
                  tr
                    td(colspan="8", style="text-align: center; padding: 20px;") Không có sự cố nào cần xử lý.

          .history-link-wrapper
            a.history-link(href="#")
              | Xem lịch sử sự cố đã khắc phục
              i.fa-solid.fa-arrow-right
            
      // ---- CỘT PHẢI: CHI TIẾT ----
      .incident-right
        //- Trạng thái trống
        #emptyDetailState.card.detail-card(style="display: flex; justify-content: center; align-items: center; flex-direction: column; min-height: 400px; color: #999;")
          i.fa-regular.fa-hand-pointer(style="font-size: 48px; margin-bottom: 16px;")
          p Chọn một dòng sự cố bên trái để xem chi tiết.

        //- Khung chi tiết (ẩn mặc định)
        #detailCard.card.detail-card(style="display: none;")
          .card-header.detail-header
            h2.card-title
              i.fa-regular.fa-clipboard.text-red
              span#detailTicketCode Chi tiết Ticket
            span#detailBadge.badge.badge--red --

          .card-body
            .info-box
              .info-row
                span.info-label Thiết bị:
                strong.info-value#detailVehicle --
              .info-row
                span.info-label Trạm Hub:
                strong.info-value#detailHub --
              .info-row
                span.info-label Loại sự cố:
                strong.info-value.text-red#detailType --
              .info-row
                span.info-label Nguồn phát hiện:
                strong.info-value#detailCreatedBy --
              .info-row
                span.info-label Thời gian ghi nhận:
                strong.info-value#detailTime --

          .remote-control-section
            h3.remote-control-title THAO TÁC BỔ SUNG / ĐIỀU KHIỂN TỪ XA
            .remote-control-actions
              button.remote-btn(type="button")
                i.fa-solid.fa-rotate
                span Khởi động lại ngầm khóa IoT
              button.remote-btn(type="button")
                i.fa-solid.fa-lock
                span Khóa chốt khẩn cấp

          //- ID detailFooter để JS điều khiển ẩn/hiện nút
          .card-footer.detail-footer#detailFooter
            button#btnConfirmTicket.btn-primary-full(type="button") Xác nhận sự cố & Yêu cầu sửa chữa
            button#btnIgnoreTicket.btn-secondary-full(type="button") Bỏ qua cảnh báo
