extends ../../layouts/admin/default.pug

block titleName
  h1.dashboard-header__title Phân hệ Mô phỏng Kịch bản (What-If Simulation Suite)

block main 
  .simulation-page.container
    
    include ../../mixins/admin/simulation-tabs.pug
    +simulationTabs('demand')

    .simulation-layout
      
      // ================= CỘT TRÁI =================
      .simulation-left
        .card.settings-card
          .card-header
            h2.card-title
              i.fa-solid.fa-sliders.text-green
              | THIẾT LẬP KỊCH BẢN

          .card-body
            .form-group
              label.form-label HUB CHỊU TÁC ĐỘNG
              //- Để trống để JS tự động đổ 4 Hub vào
              select#demandHubId.form-control 
            
            .form-group
              label.form-label KHUNG GIỜ MÔ PHỎNG
              select#demandTimeFrame.form-control
                option(value="16:30 - 17:30") 16:30 - 17:30 (Cao điểm)
                option(value="12:00 - 13:00") 12:00 - 13:00 (Nghỉ trưa)
            
            //- NHÓM 1: NHU CẦU THUÊ XE
            .form-group(style="background: #f8f9fa; padding: 12px; border-radius: 6px; margin-bottom: 12px;")
              label.form-label(style="color: #333; font-weight: 600;") NHU CẦU THUÊ XE (LƯỢT/GIỜ)
              input#simRentDemand.form-control(type="number", value="25", min="0", placeholder="Nhập nhu cầu giả định")
              small.form-text.text-muted#hintRent (Sức chứa hiện tại: -- xe)
            
            //- NHÓM 2: NHU CẦU ĐỖ XE
            .form-group(style="background: #f8f9fa; padding: 12px; border-radius: 6px; margin-bottom: 12px;")
              label.form-label(style="color: #333; font-weight: 600;") NHU CẦU ĐỖ XE (LƯỢT/GIỜ)
              input#simParkingDemand.form-control(type="number", value="30", min="0", placeholder="Nhập nhu cầu giả định")
              small.form-text.text-muted#hintParking (Sức chứa hiện tại: -- chỗ)
            
            //- NHÓM 3: NHU CẦU SẠC
            .form-group(style="background: #f8f9fa; padding: 12px; border-radius: 6px; margin-bottom: 12px;")
              label.form-label(style="color: #333; font-weight: 600;") NHU CẦU SẠC (LƯỢT/GIỜ)
              input#simChargingDemand.form-control(type="number", value="15", min="0", placeholder="Nhập nhu cầu giả định")
              small.form-text.text-muted#hintCharging (Sức chứa hiện tại: -- cổng)

          .card-footer
            button#btnRunDemandSim.btn-run(type="button")
              i.fa-solid.fa-play
              | Chạy mô phỏng kịch bản

      // ================= CỘT PHẢI =================
      .simulation-right
        
        #demandEmptyState.empty-state
          .empty-icon-box
            i.fa-regular.fa-gem
          h3.empty-state__title Chưa có kết quả mô phỏng
          p.empty-state__desc Vui lòng nhập nhu cầu giả định ở cột bên trái và bấm "Chạy mô phỏng" để xem đánh giá tác động.

        #demandResultWrapper.simulation-result-wrapper(style="display: none;")
          
          .simulation-section
            h3.section-label TRẠNG THÁI MÔ PHỎNG
            .status-compare-grid
              .status-box.status-box--simulated(style="background: #fffcf0; border-color: #ffeeba; width: 100%;")
                .status-box__list
                  .status-row
                    span Nhu cầu thuê xe:
                    strong#resSimRent --
                  .status-row
                    span Nhu cầu đỗ xe:
                    strong#resSimParking --
                  .status-row
                    span Nhu cầu sạc:
                    strong#resSimCharging --

          .simulation-section
            h3.section-label KẾT QUẢ ĐÁNH GIÁ
            .evaluation-grid
              .eval-card.eval-card--gray
                span.eval-card__label Khả năng đáp ứng thuê xe
                .eval-card__value#resEvalRent --
                span.eval-card__sub#resEvalRentSub --
                
              .eval-card.eval-card--orange
                span.eval-card__label Khả năng đáp ứng đỗ xe
                .eval-card__value#resEvalParking --
                span.eval-card__sub#resEvalParkingSub --
                
              .eval-card.eval-card--red#cardUnserved
                span.eval-card__label Khả năng đáp ứng sạc
                .eval-card__value#resEvalCharging --
                span.eval-card__sub#resEvalChargingSub --

          .recommendation-card
            .recommendation-header
              .recommendation-header__title-group
                i.fa-regular.fa-lightbulb.text-green
                h3 KHUYẾN NGHỊ VẬN HÀNH
              span#resStatusBadge.recommendation-header__badge --
              
            .recommendation-body
              .recommendation-content
                h4#resRecTitle --
                p#resRecContent --
                
                ul#demandSmartActions(style="margin-top: 16px; padding-left: 20px; font-size: 14px; color: #374151; line-height: 1.8;")
