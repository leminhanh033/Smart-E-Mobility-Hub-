extends ../../layouts/user/default.pug

block main
  main.schedule-charging

    // ================= LEFT =================
    section.schedule-charging__main
      // Tabs
      .book-parking__tabs
        a.tab-btn(href="/book/parking") Đặt chỗ đỗ
        a.tab-btn(href="/book/charging/schedule") Lập lịch sạc
        a.tab-btn.active(href="/book/charging/demand") Đăng ký nhu cầu sạc

      .schedule-charging__header
        h1.schedule-charging__title Gửi nhu cầu sạc xe điện
        p.schedule-charging__subtitle Chọn Mobility Hub bạn muốn sạc, hệ thống sẽ tiếp nhận và sắp xếp chỗ sạc tối ưu.

      // ---------- CHỌN HUB ----------
      .schedule-section
        h2.schedule-section__title
          span.schedule-section__num 1
          | CHỌN MOBILITY HUB MUỐN SẠC

        if hubList && hubList.length > 0
          .hub-picker
            each hub, index in hubList
              label.hub-pick(class=(index === 0 ? 'hub-pick--selected' : ''))
                input(
                  type="radio"
                  name="hub"
                  value=hub._id
                  data-name=hub.name
                  data-address=hub.address
                  checked=(index === 0)
                )
                .hub-pick__icon
                  i.fa-solid.fa-charging-station
                .hub-pick__info
                  strong.hub-pick__name= hub.name
                  span.hub-pick__address= hub.address
                i.fa-solid.fa-circle-check.hub-pick__check
        else
          p Không có Mobility Hub nào khả dụng.

    // ================= RIGHT: Summary =================
    aside.schedule-charging__summary
      h2.summary__label YÊU CẦU SẠC

      .summary__block
        span.summary__block-label Mobility Hub đã chọn
        strong#summaryHubName.summary__block-value Chưa chọn Hub
        span#summaryHubAddress.summary__block-sub --

      .summary__warning
        i.fa-solid.fa-triangle-exclamation
        p
          | Hệ thống sẽ ghi nhận nhu cầu sạc của bạn và điều chỉnh phù hợp.

      .summary__actions
        button.btn-outline#btnCancel(type="button") Hủy
        button#btnConfirmDemand.btn-primary(type="button") Xác nhận