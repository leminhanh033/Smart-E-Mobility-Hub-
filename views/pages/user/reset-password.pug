extends ../../layouts/user/account.pug


block main 
  // Bên phải: Form đặt lại mật khẩu
  .reset-password 
    a.btn-back(href="#")
      i.fa-solid.fa-arrow-left
      span Quay lại

    // Header với icon và tiêu đề căn giữa
    .reset-password__header
      .reset-password__icon
        i.fa-solid.fa-rotate-left
      h2.reset-password__title Đặt lại mật khẩu

    form.form
      // SĐT hoặc Email
      .form__group
        label.form__label SĐT HOẶC EMAIL
        .input-wrapper.input-wrapper--otp
          i.fa-solid.fa-phone.input-icon
          input.form__input(type="text", placeholder="0988 789 421")
          button.btn-send-otp(type="button") Gửi OTP

      // Mã xác thực OTP
      .form__group
        label.form__label MÃ XÁC THỰC OTP (6 SỐ)
        .input-wrapper
          i.fa-solid.fa-shield-halved.input-icon
          input.form__input(type="text")
          i.fa-solid.fa-circle-check.input-icon-right.success-icon

      // Mật khẩu mới
      .form__group
        label.form__label MẬT KHẨU MỚI
        .input-wrapper
          i.fa-solid.fa-lock.input-icon
          input.form__input(type="password", placeholder="••••••••••••")
          i.fa-regular.fa-eye.input-icon-right

      // Xác nhận mật khẩu mới
      .form__group
        label.form__label XÁC NHẬN MẬT KHẨU MỚI
        .input-wrapper
          i.fa-solid.fa-shield-halved.input-icon
          input.form__input(type="password", placeholder="••••••••••••")
          i.fa-solid.fa-circle-check.input-icon-right.success-icon

      // Nút cập nhật
      button.btn-submit(type="submit") Cập nhật mật khẩu

    // Footer của Form
    .form__footer
      p Nhớ lại mật khẩu? 
        a(href="/login") Đăng nhập ngay
      small ĐẠI HỌC QUỐC GIA TP.HCM • HỆ THỐNG ECOHUB